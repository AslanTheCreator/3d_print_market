{
  "name": "3d_print_market",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:3001": "cross-env PORT=3001 next dev",
    "build": "next build",
    "start": "next start",
    "test:smoke": "node --test tests/smoke/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint app src --ext .ts,.tsx --max-warnings=0",
    "architecture:check": "steiger .",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.13",
    "@mui/material-nextjs": "^5.15.11",
    "@tanstack/react-query": "^5.67.2",
    "axios": "^1.15.2",
    "framer-motion": "^12.23.12",
    "js-cookie": "^3.0.5",
    "lodash": "^4.18.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.18",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.55.0",
    "swiper": "^12.1.3",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.12.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "^15.5.18",
    "steiger": "^0.5.2",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "postcss": "8.5.12"
  }
}
