# Frontend API URL used by the browser.
# Production must use an HTTPS URL or a same-origin proxy path.
CLIENT_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Optional server-side API URL.
# Use it only when the Next.js server should call an internal backend address.
API_BASE_URL=http://backend:8081

# Local production smoke only.
# Set to true when a local Docker run must use localhost/127.0.0.1 API URLs.
ALLOW_LOCAL_API_URL=false
